{
  "name": "amu-admin-server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "NestJS backend template for amu-admin with enterprise-grade RBAC and token lifecycle.",
  "scripts": {
    "install:mirror": "pnpm --dir ../../ install --filter amu-admin-server... --registry https://registry.npmmirror.com --fetch-retries 5 --fetch-timeout 120000",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:one-click": "docker compose up --build",
    "start:one-click:detached": "docker compose up -d --build",
    "stop:one-click": "docker compose down",
    "logs:docker": "docker compose logs -f app mysql",
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "type:check": "tsc --project tsconfig.build.json --noEmit",
    "test": "pnpm --dir . exec vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.15",
    "typescript": "^5.7.2"
  }
}

